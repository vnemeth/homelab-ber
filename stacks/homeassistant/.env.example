# The Zigbee coordinator, preferably by its stable path, e.g. /dev/serial/by-id/usb-...
ZIGBEE_DEVICE=changeme
# Adapter type of the coordinator: zstack, ember, deconz, zigate or zboss
ZIGBEE_ADAPTER=changeme
# Password of the "zigbee2mqtt" user in Mosquitto's password file
Z2M_MQTT_PASSWORD=changeme
