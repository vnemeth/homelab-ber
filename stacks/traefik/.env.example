# DreamHost API key with the dns-list_records, dns-add_record and dns-remove_record
# functions, used for the Let's Encrypt DNS challenge
DREAMHOST_API_KEY=changeme

# Login for the Traefik dashboard, in htpasswd format (user:bcrypt-hash). Keep the single
# quotes so the $ signs in the hash aren't interpreted. Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB valentin 'your-password'
TRAEFIK_DASHBOARD_USERS='valentin:changeme'
