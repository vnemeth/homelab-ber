# Copy to secrets.yaml (git-ignored) on the server and fill in
wifi_ssid: "changeme"
wifi_password: "changeme"
# 32 random bytes, base64: openssl rand -base64 32. Also encrypts OTA updates, and
# Home Assistant asks for it when adding the device
api_encryption_key: "changeme"
# Password of the fallback hotspot; at least 8 characters
fallback_ap_password: "changeme"
